# Server-side only. Never expose this value to the browser.
# Configure the local OpenCode provider to consume this key; never commit .env.
OPENCODE_API_KEY=
# Verify the model identifier against the locally configured OpenCode provider at startup.
# Supported local examples (choose one only after it appears in /config/providers):
# OPENCODE_MODEL=opencode-go/deepseek-v4-flash
# OPENCODE_MODEL=opencode-go/deepseek-v4-pro
OPENCODE_MODEL=
# Loopback URL of an already running local OpenCode server (for example http://127.0.0.1:4096).
OPENCODE_URL=
# Exact OpenCode Server version required by the local Product contract.
OPENCODE_EXPECTED_VERSION=1.18.11
# Absolute canonical default profile directory reported through directory-scoped /path.
# Product Conversations are independently scoped to server-derived owner workspaces.
OPENCODE_WORKDIR=
# Comma-separated provider IDs allowed for this demo (for example opencode-go).
# For the examples above, set: OPENCODE_ALLOWED_PROVIDERS=opencode-go
OPENCODE_ALLOWED_PROVIDERS=
# Optional basic authentication for the local OpenCode server.
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=

# Optional administrator gate for the public demo. Configure both values
# together. The administrator generates revocable test-user login keys and
# assigns quota through /admin. Store only a scrypt hash, never plaintext.
# Generate the hash in a trusted shell with createScryptPasswordHash from
# backend/src/test-user-access.ts.
RIFF_TEST_ADMIN_USERNAME=
RIFF_TEST_ADMIN_PASSWORD_HASH=
# Each asynchronous Turn reserves this much quota until it settles.
RIFF_TEST_USER_TURN_TOKEN_RESERVE=32768
# Keep true for the deterministic local demo; set false only for configured live OpenCode verification.
RIFF_SKIP_OPENCODE=true
# Local emergency rollback only. Default false means `/` launches Riffology;
# setting this true before rebuilding restores the historical Product shell.
VITE_RIFFOLOGY_LEGACY_PRODUCT_UI=false
# Match the Vite rollback flag only for local recovery, so legacy owner refreshes work.
RIFF_LEGACY_PRODUCT_UI=false
# Optional production ingress contract. Configure both canonical HTTPS origins;
# the Node listeners and OpenCode remain loopback-only behind a trusted reverse proxy.
RIFF_PUBLIC_APP_ORIGIN=
RIFF_PUBLIC_BROKER_ORIGIN=
