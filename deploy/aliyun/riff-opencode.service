[Unit]
Description=Riffology private OpenCode server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/riff-demo
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/opencode serve --hostname 127.0.0.1 --port 4096 --print-logs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
