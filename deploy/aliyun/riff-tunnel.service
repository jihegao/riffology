[Unit]
Description=Cloudflare Tunnel for Riffology online demo
After=network-online.target riff-demo.service
Wants=network-online.target
Requires=riff-demo.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/cloudflared tunnel --config %h/.cloudflared/riff-demo.yml run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
