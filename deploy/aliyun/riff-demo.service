[Unit]
Description=Riffology online demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/riff-demo/backend
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/riff-demo/riff-demo.env
ExecStart=%h/.local/bin/node --experimental-strip-types src/index.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
